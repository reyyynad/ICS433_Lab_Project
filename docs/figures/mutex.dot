digraph M {
  graph [rankdir=TB, fontname="Liberation Sans", nodesep=0.3, ranksep=0.28, pad=0.2];
  node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=10, fillcolor="#f2f2f2", color="#555555"];
  edge [fontname="Liberation Sans", fontsize=9, color="#555555", arrowsize=0.7];
  subgraph cluster_l { label=<<b>wv_mutex_lock(m)</b>>; fontname="Liberation Sans"; color="#999999"; style=rounded;
    l1 [label="sched_lock()\n(mask SIGVTALRM)"];
    l2 [label="caller already\nowns m?", shape=diamond, fillcolor="white"];
    l3 [label="m->locked?", shape=diamond, fillcolor="white"];
    l4 [label="locked = 1\nowner = caller"];
    l5 [label="sched_block(self)\nwaitq_push(m->queue, self)\nsched_yield_to_next()"];
    l6 [label="woken: already the owner\n(ownership was handed over)"];
    l7 [label="sched_unlock(); return WV_OK", fillcolor="#dbe9fb"];
    le [label="return WV_ERR_INVALID", fillcolor="#fbe3db"];
    l1 -> l2; l2 -> le [label="yes"]; l2 -> l3 [label="no"];
    l3 -> l4 [label="no"]; l3 -> l5 [label="yes"]; l5 -> l6; l4 -> l7; l6 -> l7;
  }
  subgraph cluster_u { label=<<b>wv_mutex_unlock(m)</b>>; fontname="Liberation Sans"; color="#999999"; style=rounded;
    u1 [label="sched_lock()"];
    u2 [label="caller owns m?", shape=diamond, fillcolor="white"];
    u3 [label="next = waitq_pop(m->queue)"];
    u4 [label="next != NULL?", shape=diamond, fillcolor="white"];
    u5 [label="owner = next (stays locked)\nsched_wake(next)"];
    u6 [label="locked = 0, owner = -1"];
    u7 [label="sched_unlock(); return WV_OK", fillcolor="#dbe9fb"];
    ue [label="return WV_ERR_NOTOWNER", fillcolor="#fbe3db"];
    u1 -> u2; u2 -> ue [label="no"]; u2 -> u3 [label="yes"]; u3 -> u4;
    u4 -> u5 [label="yes"]; u4 -> u6 [label="no"]; u5 -> u7; u6 -> u7;
  }
}
